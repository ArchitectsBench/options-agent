<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.optionsagent.cockpitapi</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/you/projects/OptionsAgent/.venv/bin/uvicorn</string>
        <string>src.api.server:app</string>
        <string>--port</string>
        <string>8421</string>
        <string>--host</string>
